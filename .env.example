# ── Capote Voice backend — copy to .env and fill from the Intermedia portal ──
# Reseller Portal → Partner Account → Integrations → Elevate API authentication

PORT=8080
# Public base URL of THIS backend (used to build the OAuth redirect URI).
# Local dev: use a tunnel (ngrok/cloudflared) if Intermedia requires https.
PUBLIC_BASE_URL=http://localhost:8080

# ── OAuth client ID (section "OAuth client IDs" → Add client ID) ──
# Used for the USER login (Authorization Code + PKCE). Confidential client:
# the secret stays here, never in the app.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Must EXACTLY match the redirect registered in the portal:
#   ${PUBLIC_BASE_URL}/auth/callback
OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback
# User-login scopes (Authorization Code). Confirmed against the Intermedia Extend SDK.
OAUTH_SCOPES=api.user.address-book api.user.voice.calls api.user.voice.voicemails api.user.video-conference api.user.messaging offline_access

# ── Service account (section "Service accounts" → Add account) ──
# Server-to-server (client_credentials). Can reach ALL user data — keep secret.
SERVICE_ACCOUNT_CLIENT_ID=
SERVICE_ACCOUNT_CLIENT_SECRET=

# ── Intermedia Extend endpoints (confirmed via the official Extend SDK) ──
INTERMEDIA_AUTH_URL=https://login.intermedia.net/user/connect/authorize
INTERMEDIA_TOKEN_URL=https://login.intermedia.net/user/connect/token
INTERMEDIA_API_BASE=https://api.intermedia.net
# Service-account scopes (client_credentials, api.service.*)
SERVICE_SCOPES=api.service.analytics.main api.service.voice.call-recordings api.service.messaging

# ── App handoff ──
# Custom scheme the backend redirects to after login, to hand the app its session.
APP_REDIRECT_SCHEME=capotevoice://auth/callback

# Secret used to sign the app session JWT this backend issues (generate a random one).
APP_JWT_SECRET=change-me-to-a-long-random-string
